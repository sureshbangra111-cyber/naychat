{
  "name": "anonymous-support-chat",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build && npm run build:server",
    "start": "npm run build && npm run serve",
    "serve": "cross-env NODE_ENV=production node dist-server/index.js",
    "build:web": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "tsc -b --pretty && tsc -p server/tsconfig.json --noEmit",
    "create-admin": "cross-env NODE_ENV=production tsx server/scripts/create-admin.ts",
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "npm run dev:server & npm run dev",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-server',{recursive:true,force:true})\"",
    "create-admin:compiled": "cross-env NODE_ENV=production node dist-server/scripts/create-admin.js",
    "test:api": "node e2e-api-test.mjs",
    "test:customer": "node e2e-browser-test.mjs",
    "test:admin": "node e2e-admin-test.mjs",
    "test:responsive": "node e2e-responsive-test.mjs",
    "test:security": "node e2e-security-test.mjs",
    "test:regression": "node e2e-regression-test.mjs",
    "test:e2e": "npm run test:api && npm run test:meta && npm run test:customer && npm run test:admin && npm run test:responsive && npm run test:security && npm run test:regression && npm run test:a11y && npm run test:meta:browser",
    "test:a11y": "node e2e-a11y-test.mjs",
    "test:meta": "node e2e-meta-test.mjs",
    "test:meta:browser": "node e2e-meta-browser-test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "lucide-react": "^1.51.0",
    "mongoose": "^9.10.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.9",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0"
  }
}
