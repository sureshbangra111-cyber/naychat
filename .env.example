# =============================================================================
# FRONTEND ENV
#
# The browser bundle needs NO secrets. There is no database URL, no session
# secret and no admin password here — and nothing here is a secret.
#
# All server configuration lives in `server/.env.example`.
# =============================================================================

# Leave EMPTY for local development: Vite proxies /api to the Express server, so
# the httpOnly session cookies stay same-origin and behave exactly as in
# production. Leave it empty there too when the API is served from the same host.
#
# Only set this for a genuinely split deployment (API on another origin), in
# which case that origin must also be listed in the server's CORS_ORIGINS.
# VITE_API_URL=https://api.example.com
