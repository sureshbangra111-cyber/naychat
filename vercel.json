{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "builds": [
    {
      "src": "dist-server/handler.js",
      "use": "@vercel/node",
      "includeFiles": [
        "dist/**"
      ]
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist-server/handler.js"
    }
  ]
}
