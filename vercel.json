{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "includeFiles": ["dist/**"],
  "builds": [
    {
      "src": "dist-server/handler.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "dist-server/handler.js" }
  ]
}
