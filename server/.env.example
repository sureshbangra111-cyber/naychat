# =============================================================================
# SERVER ENVIRONMENT — copy to `server/.env` (or the project-root `.env`).
#
# EVERYTHING HERE IS SERVER-SIDE ONLY.
# None of these are prefixed VITE_, so Vite will never inline them into the
# browser bundle. Do not rename them to VITE_*.
# =============================================================================

# ---- Database (required) ----------------------------------------------------
# Real MongoDB connection string. There is no default and no fallback: the server
# refuses to start without one, so a misconfigured deploy fails loudly instead of
# silently writing to the wrong place.
#
# Local:  mongodb://127.0.0.1:27017/support_chat
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=support_chat

# ---- Sessions (required) ----------------------------------------------------
# Signs the httpOnly session cookies. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this logs every session out. Never reuse it across environments.
SESSION_SECRET=replace-with-a-long-random-string

# ---- Admin bootstrap (used ONLY by `npm run create-admin`) ------------------
# Run that command to hash ADMIN_PASSWORD into MongoDB. The plaintext password is
# never stored, never logged and never sent to the browser.
ADMIN_EMAIL=admin@chatadmin.local
# EITHER set ADMIN_PASSWORD (hashed at creation time)...
#
# ⚠️  WRAP ANY PASSWORD IN DOUBLE QUOTES. dotenv treats an unquoted `#` as the
#     start of a comment, so `Admin@2026#Secure` silently becomes
#     `Admin@2026` and every sign-in fails with no obvious cause.
#     The quotes below are REQUIRED for this password.
ADMIN_PASSWORD="Admin@2026#Secure"
# ...OR paste an existing bcrypt hash and leave ADMIN_PASSWORD empty.
ADMIN_PASSWORD_HASH=
ADMIN_ROLE=owner
ADMIN_FULL_NAME=Admin

# ---- HTTP -------------------------------------------------------------------
PORT=4000
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:5176

# ---- Meta Ads / Conversions API (SERVER-ONLY) ------------------------------
# ⚠️  THE PIXEL ID IS *NOT* CONFIGURED HERE FOR THE BROWSER.
#
# The browser Pixel ID is a RUNTIME setting stored in MongoDB and edited from
# Admin -> Settings. Changing it there takes effect immediately, with NO rebuild
# and NO redeploy. Do not add a VITE_META_PIXEL_ID: that would re-introduce a
# build-time value and defeat the whole point.
#
# The values below are the SERVER-SIDE Conversions API configuration only.
#
# META_PIXEL_ID — your Meta Pixel / Dataset ID, used to address the Conversions
# API endpoint. It is a fallback for deployments that never use the admin UI.
# It is NEVER sent to the browser.
META_PIXEL_ID=

# 🔴 SECRET — the Conversions API access token.
#
# This is a credential. It must NEVER appear in:
#   * frontend code or any VITE_* variable
#   * MongoDB / the AppSettings collection
#   * the GET /api/public/config response
#   * the Admin Settings UI
#   * server logs
#
# It is read from the server environment only. When it is empty, every
# Conversions API call becomes a silent no-op and the browser Pixel keeps working
# on its own — which is a perfectly valid, Pixel-only setup.
META_CONVERSIONS_API_ACCESS_TOKEN=

# Graph API version used for Conversions API calls.
META_GRAPH_API_VERSION=v21.0
# Set to false to disable ALL server-side Conversions API delivery (browser Pixel
# is unaffected).
META_CONVERSIONS_API_ENABLED=true

# ---- Media attachments (images + voice messages) ---------------------------
# Attachment bytes are written by a storage driver and NEVER into a message
# document and never as base64. MongoDB stores metadata only (storageKey,
# mimeType, size, dimensions, duration); the browser can only ever read the
# bytes back through the authorised GET /api/attachments/:id route.
#
# NONE of these may be renamed to VITE_* — Vite inlines VITE_-prefixed values
# into the browser bundle, which would leak the storage root and the limits.

# Upload size limits in megabytes. The server enforces these against the number
# of bytes actually streamed in, so a lying Content-Length cannot bypass them.
IMAGE_MAX_SIZE_MB=10
AUDIO_MAX_SIZE_MB=10

# `local` writes to ATTACHMENT_STORAGE_DIR (fine for a single Node process or a
# host with a persistent volume). Switching to object storage means implementing
# the AttachmentStorage interface in
# server/services/attachments/storage.ts and pointing this at that driver — no
# controller, service, model or frontend change is required.
ATTACHMENT_STORAGE_DRIVER=local
# Relative to server/. Resolved to an absolute path at boot and created if
# missing, with mode 0700. This path is NEVER sent to the browser.
ATTACHMENT_STORAGE_DIR=../.data/attachments

# An upload that is never attached to a message is deleted, together with its
# stored object, once it is older than this. Defaults to one hour.
ATTACHMENT_ORPHAN_TTL_MS=3600000
# Abuse guard: how many attachments one conversation may hold.
ATTACHMENT_MAX_PER_CONVERSATION=100
# Longest caption that may accompany an image or voice note.
ATTACHMENT_MAX_CAPTION_LENGTH=1000

# ---- Optional tuning --------------------------------------------------------
ADMIN_SESSION_TTL_MS=28800000
VISITOR_SESSION_TTL_MS=2592000000
MAX_MESSAGE_LENGTH=4000
MAX_CONVERSATIONS_PER_VISITOR=25
DEFAULT_COMPANY_NAME=Support Team
DEFAULT_WELCOME_MESSAGE=Hi 👋 How can we help you today?
